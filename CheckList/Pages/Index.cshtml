@page
@model IndexModel
@{
    ViewData["Title"] = "Bubu y Dudu Tareas";
}

<link rel="stylesheet" href="~/css/checklist.css" asp-append-version="true" />

<div class="wrapper" id="app">
    
    <div class="main" id="main">
        <div>
            <div class="col-header">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.1" /><path d="M6.5 4v2.5l1.5 1.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Diarias
                <span class="badge" id="daily-badge">0</span>
            </div>
            <div class="progress-bar-wrap"><div class="progress-bar" id="daily-progress" style="width:0%"></div></div>
            <div class="card" id="daily-list"></div>
        </div>
        <div>
            <div class="col-header">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><rect x="0.5" y="1.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.1" /><path d="M4 0.5v2M9 0.5v2M0.5 5.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Hoy
                <span class="badge" id="today-badge">0</span>
                <span class="col-date" id="today-date"></span>
            </div>
            <div class="progress-bar-wrap"><div class="progress-bar" id="today-progress" style="width:0%"></div></div>
            <div class="card" id="today-list"></div>
        </div>
        <div>
            <div class="col-header">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><rect x="0.5" y="1.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.1" /><path d="M4 0.5v2M9 0.5v2M0.5 5.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Mañana
                <span class="badge" id="tomorrow-badge">0</span>
                <span class="col-date" id="tomorrow-date"></span>
            </div>
            <div class="progress-bar-wrap" style="visibility:hidden"><div class="progress-bar" style="width:0%"></div></div>
            <div class="card" id="tomorrow-list"></div>
        </div>
    </div>
</div>

<script>
    const pad = n => String(n).padStart(2,'0');
    const now = new Date();
    const tomorrow = new Date(now); tomorrow.setDate(tomorrow.getDate()+1);
    const days = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    const fmtShort = d => `${days[d.getDay()]} ${pad(d.getDate())}/${pad(d.getMonth()+1)}`;

    document.getElementById('today-date').textContent = fmtShort(now);
    document.getElementById('tomorrow-date').textContent = fmtShort(tomorrow);

    let state = {
      daily: [
        { id:1, label:'Regar plantas', done:true, persona:'Bubu' },
        { id:2, label:'Sacar basura', done:false, persona:'' },
        { id:3, label:'Revisar correos', done:false, persona:'Dudu' },
      ],
      today: [
        { id:4, label:'Pagar impuesto', time:'10:00', done:true, persona:'Bubu' },
        { id:5, label:'Bañar al perro', time:'16:30', done:false, persona:'' },
      ],
      tomorrow: [
        { id:6, label:'Llamar a Rigorberto', time:'', done:false, persona:'' },
        { id:7, label:'Pagar tarjeta', time:'12:00', done:false, persona:'Dudu' },
      ],
      nextId: 8
    };

    function checkSVG() {
      return `<svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M2 5.5l2.5 2.5L9 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    }

    function renderCheckList(listId, tasks, badgeId, progressId) {
      const el = document.getElementById(listId);
      document.getElementById(badgeId).textContent = tasks.length;
      const done = tasks.filter(t=>t.done).length;
      document.getElementById(progressId).style.width = tasks.length ? Math.round(done/tasks.length*100)+'%' : '0%';
      if (!tasks.length) { el.innerHTML = emptyState(); return; }
      el.innerHTML = tasks.map(t => `
        <div class="task-item" onclick="toggle('${listId}',${t.id})">
          <div class="checkbox${t.done?' checked':''}">${t.done?checkSVG():''}</div>
          <div class="task-info">
            <div class="task-label${t.done?' done':''}">${t.label}</div>
            <div class="task-meta">
              ${t.time?`<span class="task-time"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1"/><path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>${t.time}</span>`:''}
              ${t.persona?`<span class="task-persona"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="3" cy="2.5" r="1.5" stroke="currentColor" stroke-width="0.8"/><path d="M0.5 9.5c0-1.3 1.3-2.5 2.5-2.5s2.5 1.2 2.5 2.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/></svg>${t.persona}</span>`:''}
            </div>
          </div>
        </div>`).join('');
    }

    function renderTomorrowList(tasks) {
      const el = document.getElementById('tomorrow-list');
      document.getElementById('tomorrow-badge').textContent = tasks.length;
      if (!tasks.length) { el.innerHTML = emptyState(); return; }
      el.innerHTML = tasks.map(t => `
        <div class="tomorrow-item">
          <div class="tomorrow-dot"></div>
          <div class="task-info">
            <div class="task-label">${t.label}</div>
            <div class="task-meta">
              ${t.time?`<span class="task-time"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1"/><path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>${t.time}</span>`:''}
              ${t.persona?`<span class="task-persona"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="3" cy="2.5" r="1.5" stroke="currentColor" stroke-width="0.8"/><path d="M0.5 9.5c0-1.3 1.3-2.5 2.5-2.5s2.5 1.2 2.5 2.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/></svg>${t.persona}</span>`:''}
            </div>
          </div>
        </div>`).join('');
    }

    function emptyState() {
      return `<div class="empty-state"><svg width="26" height="26" viewBox="0 0 26 26" fill="none"><rect x="1" y="1" width="24" height="24" rx="5" stroke="var(--color-border-secondary)" stroke-width="1" stroke-dasharray="4 3"/><path d="M8 13h10M13 8v10" stroke="var(--color-border-secondary)" stroke-width="1.1" stroke-linecap="round"/></svg>Sin tareas</div>`;
    }

    function render() {
      renderCheckList('daily-list', state.daily, 'daily-badge', 'daily-progress');
      renderCheckList('today-list', state.today, 'today-badge', 'today-progress');
      renderTomorrowList(state.tomorrow);
    }

    function toggle(listId, id) {
      const key = listId === 'daily-list' ? 'daily' : 'today';
      const t = state[key].find(t=>t.id===id);
      if (t) t.done = !t.done;
      render();
    }

    render();
</script>

<style>
    .task-meta {
        font-size: 11px;
        color: var(--color-text-tertiary);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .task-meta span {
        display: flex;
        align-items: center;
        gap: 3px;
    }
</style>
