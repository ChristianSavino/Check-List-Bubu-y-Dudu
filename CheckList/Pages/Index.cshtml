@page
@model IndexModel
@{
    ViewData["Title"] = "Bubu y Dudu Tareas";
}

<link rel="stylesheet" href="~/css/checklist.css" asp-append-version="true" />

<div class="wrapper" id="app">
    <div class="main" id="main">

        @* DIARIAS *@
        <div>
            <div class="col-header">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.1" /><path d="M6.5 4v2.5l1.5 1.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Diarias
                <span class="badge" id="daily-badge">@Model.Daily.Count</span>
            </div>
            <div class="progress-bar-wrap"><div class="progress-bar" id="daily-progress" style="width:@(Model.Daily.Count > 0 ? Math.Round((double)Model.Daily.Count(t => t.Done) / Model.Daily.Count * 100) : 0)%"></div></div>
            <div class="card" id="daily-list"></div>
        </div>

        @* HOY *@
        <div>
            <div class="col-header">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><rect x="0.5" y="1.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.1" /><path d="M4 0.5v2M9 0.5v2M0.5 5.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Hoy
                <span class="badge" id="today-badge">@Model.Today.Count</span>
                <span class="col-date" id="today-date"></span>
            </div>
            <div class="progress-bar-wrap"><div class="progress-bar" id="today-progress" style="width:@(Model.Today.Count > 0 ? Math.Round((double)Model.Today.Where(t => !t.EsEvento).Count(t => t.Done) / Math.Max(Model.Today.Count(t => !t.EsEvento), 1) * 100) : 0)%"></div></div>
            <div class="card" id="today-list"></div>
        </div>

        @* MAÑANA *@
        <div>
            <div class="col-header">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><rect x="0.5" y="1.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.1" /><path d="M4 0.5v2M9 0.5v2M0.5 5.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Mañana
                <span class="badge" id="tomorrow-badge">@Model.Tomorrow.Count</span>
                <span class="col-date" id="tomorrow-date"></span>
            </div>
            <div class="progress-bar-wrap" style="visibility:hidden"><div class="progress-bar" style="width:0%"></div></div>
            <div class="card" id="tomorrow-list"></div>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    // ─── Fechas ──────────────────────────────────────────────────────
    var pad = function(n) { return String(n).padStart(2, '0'); };
    var now = new Date();
    var tmrw = new Date(now); tmrw.setDate(tmrw.getDate() + 1);
    var dayNames = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
    var fmtShort = function(d) { return dayNames[d.getDay()] + ' ' + pad(d.getDate()) + '/' + pad(d.getMonth() + 1); };

    document.getElementById('today-date').textContent = fmtShort(now);
    document.getElementById('tomorrow-date').textContent = fmtShort(tmrw);

    // ─── Estado inicial ──────────────────────────────────────────────
    var state = {
        daily:    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Daily)),
        today:    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Today)),
        tomorrow: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tomorrow))
    };

    // ─── Helpers ─────────────────────────────────────────────────────
    function checkSVG() {
        return '<svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M2 5.5l2.5 2.5L9 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    function emptyState() {
        return '<div class="empty-state"><svg width="26" height="26" viewBox="0 0 26 26" fill="none"><rect x="1" y="1" width="24" height="24" rx="5" stroke="var(--color-border-secondary)" stroke-width="1" stroke-dasharray="4 3"/><path d="M8 13h10M13 8v10" stroke="var(--color-border-secondary)" stroke-width="1.1" stroke-linecap="round"/></svg>Sin tareas</div>';
    }

    function timeSVG() {
        return '<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1"/><path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>';
    }

    function personaSVG() {
        return '<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="3" cy="2.5" r="1.5" stroke="currentColor" stroke-width="0.8"/><path d="M0.5 9.5c0-1.3 1.3-2.5 2.5-2.5s2.5 1.2 2.5 2.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/></svg>';
    }

    function renderMeta(t) {
        var time    = t.Time    ? '<span class="task-time">' + timeSVG() + escapeHtml(t.Time) + '</span>' : '';
        var persona = t.Persona ? '<span class="task-persona">' + personaSVG() + escapeHtml(t.Persona) + '</span>' : '';
        var atraso  = t.DiasAtraso > 0
            ? '<span class="task-atraso">⚠ ' + t.DiasAtraso + ' día' + (t.DiasAtraso > 1 ? 's' : '') + ' atrasada</span>'
            : '';
        if (time || persona || atraso) {
            return '<div class="task-meta">' + time + persona + atraso + '</div>';
        }
        return '';
    }

    function renderTaskItem(t) {
        var typeTag = '';
        if (t.TipoTareaLabel && t.TipoTareaLabel !== 'Diaria') {
            typeTag = ' <span class="task-type">' + escapeHtml(t.TipoTareaLabel) + '</span>';
        }

        // Cumpleaños: sin checkbox, con ícono de tortita, sin persona
        if (t.EsEvento && t.TipoTarea === 'birthday') {
            return '<div class="task-item event-item birthday-item">'
                + '<div class="event-icon">🎂</div>'
                + '<div class="task-info">'
                + '<div class="task-label">' + escapeHtml(t.Label) + ' <span class="task-type">Cumpleaños</span></div>'
                + '</div></div>';
        }

        // Eventos: sin checkbox, con ícono de calendario
        if (t.EsEvento) {
            return '<div class="task-item event-item">'
                + '<div class="event-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1"/><path d="M4 0.5v3M10 0.5v3M1 5.5h12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/><path d="M4 8h2M8 8h2M4 10.5h2" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/></svg></div>'
                + '<div class="task-info">'
                + '<div class="task-label">' + escapeHtml(t.Label) + ' <span class="task-type">Evento</span></div>'
                + (t.Persona ? '<div class="task-meta"><span class="task-persona">' + personaSVG() + escapeHtml(t.Persona) + '</span></div>' : '')
                + '</div></div>';
        }

        // Tareas normales: con checkbox
        return '<div class="task-item" onclick="toggle(' + t.Id + ')">'
            + '<div class="checkbox' + (t.Done ? ' checked' : '') + '">' + (t.Done ? checkSVG() : '') + '</div>'
            + '<div class="task-info">'
            + '<div class="task-label' + (t.Done ? ' done' : '') + '">' + escapeHtml(t.Label) + typeTag + '</div>'
            + renderMeta(t)
            + '</div></div>';
    }

    // ─── Render listas ───────────────────────────────────────────────
    function renderCheckList(listId, tasks, badgeId, progressId) {
        var el = document.getElementById(listId);
        document.getElementById(badgeId).textContent = tasks.length;
        var completable = tasks.filter(function(t) { return !t.EsEvento; });
        var done = completable.filter(function(t) { return t.Done; }).length;
        document.getElementById(progressId).style.width =
            completable.length ? Math.round(done / completable.length * 100) + '%' : '0%';

        if (!tasks.length) { el.innerHTML = emptyState(); return; }
        el.innerHTML = tasks.map(renderTaskItem).join('');
    }

    function renderTomorrowList(tasks) {
        var el = document.getElementById('tomorrow-list');
        document.getElementById('tomorrow-badge').textContent = tasks.length;
        if (!tasks.length) { el.innerHTML = emptyState(); return; }

        el.innerHTML = tasks.map(function(t) {
            var typeTag = '';
            if (t.TipoTareaLabel && t.TipoTareaLabel !== 'Diaria') {
                typeTag = ' <span class="task-type">' + escapeHtml(t.TipoTareaLabel) + '</span>';
            }
            // Cumpleaños: icono de tortita
            if (t.EsEvento && t.TipoTarea === 'birthday') {
                return '<div class="tomorrow-item event-item birthday-item">'
                    + '<div class="event-icon">🎂</div>'
                    + '<div class="task-info"><div class="task-label">' + escapeHtml(t.Label) + ' <span class="task-type">Cumpleaños</span></div></div>'
                    + '</div>';
            }
            if (t.EsEvento) {
                return '<div class="tomorrow-item event-item">'
                    + '<div class="event-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1"/><path d="M4 0.5v3M10 0.5v3M1 5.5h12" stroke="currentColor" stroke-width="1" stroke-linecap="round"/><path d="M4 8h2M8 8h2M4 10.5h2" stroke="currentColor" stroke-width="0.8" stroke-linecap="round"/></svg></div>'
                    + '<div class="task-info"><div class="task-label">' + escapeHtml(t.Label) + ' <span class="task-type">Evento</span></div></div>'
                    + '</div>';
            }
            return '<div class="tomorrow-item">'
                + '<div class="tomorrow-dot"></div>'
                + '<div class="task-info"><div class="task-label">' + escapeHtml(t.Label) + typeTag + '</div>'
                + renderMeta(t) + '</div></div>';
        }).join('');
    }

    function render() {
        renderCheckList('daily-list',  state.daily,   'daily-badge',  'daily-progress');
        renderCheckList('today-list',  state.today,   'today-badge',  'today-progress');
        renderTomorrowList(state.tomorrow);
    }

    // ─── Toggle ──────────────────────────────────────────────────────
    function toggle(id) {
        applyToggle(id);
        fetch('/api/tareas/toggle/' + id, { method: 'POST' })
            .then(function(r) { if (!r.ok) { applyToggle(id); } })
            .catch(function() { applyToggle(id); });
    }

    function applyToggle(id) {
        var found = false;
        ['daily', 'today', 'tomorrow'].forEach(function(key) {
            if (found) return;
            var task = state[key].find(function(t) { return t.Id === id; });
            if (task && !task.EsEvento) {
                task.Done = !task.Done;
                found = true;
            }
        });
        if (found) render();
    }

    // ─── SignalR ─────────────────────────────────────────────────────
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/checklistHub")
        .withAutomaticReconnect()
        .build();

    connection.on("TaskToggled", function(data) {
        ['daily', 'today', 'tomorrow'].forEach(function(key) {
            var task = state[key].find(function(t) { return t.Id === data.id; });
            if (task && task.Done !== data.completada) {
                task.Done = data.completada;
                render();
            }
        });
    });

    connection.on("TasksUpdated", function() {
        window.location.reload();
    });

    connection.start().catch(function(err) { console.error('SignalR error:', err); });

    render();
</script>

<style>
    .task-meta {
        font-size: 11px;
        color: var(--color-text-tertiary);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .task-meta span {
        display: flex;
        align-items: center;
        gap: 3px;
    }
    .task-atraso {
        color: #e07b39;
        font-weight: 500;
    }
    .event-item {
        cursor: default !important;
        opacity: 0.95;
    }
    .event-icon {
        font-size: 16px;
        width: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>
