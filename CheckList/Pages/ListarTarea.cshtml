                                    </div>
                                    <div class="tarea-content">
                                        <div class="tarea-header">
                                            <div class="tarea-nombre">@tarea.Nombre</div>
                                            <div class="tarea-tipo">@tarea.TipoLabel</div>
                                        </div>
                                        <div class="tarea-details">
                                            @if (!string.IsNullOrEmpty(tarea.DiaSemana))
                                            {
                                                <span class="tarea-diasemana">
                                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="0.8" /><path d="M5 2.5v3L7 6.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                                                    @tarea.DiaSemana
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(tarea.Hora))
                                            {
                                                <span class="tarea-hora">
                                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="0.8" /><path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                                                    @tarea.Hora
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(tarea.Persona))
                                            {
                                                <span class="tarea-persona">
                                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="3" cy="2.5" r="1.5" stroke="currentColor" stroke-width="0.8" /><path d="M0.5 9.5c0-1.3 1.3-2.5 2.5-2.5s2.5 1.2 2.5 2.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                                                    @tarea.Persona
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="tarea-actions">
                                        <a asp-page="/AgregarTarea" asp-route-id="@tarea.Id" class="btn-action btn-edit">
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 10l1.5-1.5 6.5-6.5 1.5 1.5-6.5 6.5L2 10z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /><path d="M8.5 2.5l2.5 2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" /></svg>
                                            Modificar
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@tarea.Id" style="display: inline;">
                                            <button type="submit" class="btn-action btn-delete" onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 3h12M4 3v8c0 0.6 0.4 1 1 1h4c0.6 0 1-0.4 1-1V3M6 5v5M8 5v5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ESPECÍFICAS *@
                @if (especificas.Any())
                {
                    <div class="section-group">
                        <div class="section-title">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><rect x="0.5" y="1.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.1" /><path d="M4 0.5v2M9 0.5v2M0.5 5.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                            Específicas
                        </div>
                        <div class="tareas-list" data-type="specific">
                            @foreach (var tarea in especificas)
                            {
                                <div class="tarea-item" draggable="true" data-id="@tarea.Id">
                                    <div class="drag-handle">
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="4" cy="4" r="1.5" fill="currentColor" /><circle cx="4" cy="9" r="1.5" fill="currentColor" /><circle cx="4" cy="14" r="1.5" fill="currentColor" /><circle cx="9" cy="4" r="1.5" fill="currentColor" /><circle cx="9" cy="9" r="1.5" fill="currentColor" /><circle cx="9" cy="14" r="1.5" fill="currentColor" /></svg>
                                    </div>
                                    <div class="tarea-content">
                                        <div class="tarea-header">
                                            <div class="tarea-nombre">@tarea.Nombre</div>
                                            <div class="tarea-tipo">@tarea.TipoLabel</div>
                                        </div>
                                        <div class="tarea-details">
                                            @if (!string.IsNullOrEmpty(tarea.Fecha))
                                            {
                                                <span class="tarea-fecha">
                                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.5" y="1.5" width="9" height="8" rx="1" stroke="currentColor" stroke-width="0.8" /><path d="M3 0.5v2M7 0.5v2M0.5 4h9" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                                                    @DateTime.Parse(tarea.Fecha).ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(tarea.Hora))
                                            {
                                                <span class="tarea-hora">
                                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="0.8" /><path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                                                    @tarea.Hora
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(tarea.Persona))
                                            {
                                                <span class="tarea-persona">
                                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="3" cy="2.5" r="1.5" stroke="currentColor" stroke-width="0.8" /><path d="M0.5 9.5c0-1.3 1.3-2.5 2.5-2.5s2.5 1.2 2.5 2.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                                                    @tarea.Persona
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="tarea-actions">
                                        <a asp-page="/AgregarTarea" asp-route-id="@tarea.Id" class="btn-action btn-edit">
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 10l1.5-1.5 6.5-6.5 1.5 1.5-6.5 6.5L2 10z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /><path d="M8.5 2.5l2.5 2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" /></svg>
                                            Modificar
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@tarea.Id" style="display: inline;">
                                            <button type="submit" class="btn-action btn-delete" onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 3h12M4 3v8c0 0.6 0.4 1 1 1h4c0.6 0 1-0.4 1-1V3M6 5v5M8 5v5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!Model.Tareas.Any())
                {
                    <div class="empty-state">
                        <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><rect x="1" y="1" width="24" height="24" rx="5" stroke="var(--color-border-secondary)" stroke-width="1" stroke-dasharray="4 3" /><path d="M8 13h10M13 8v10" stroke="var(--color-border-secondary)" stroke-width="1.1" stroke-linecap="round" /></svg>
                        Sin tareas
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Componente para renderizar una tarea *@
@{
    RenderFragment<(TareaListDto tarea, bool showDay)> RenderTaskItem = (item) =>
    @<div class="tarea-item" draggable="true" data-id="@item.tarea.Id">
        <div class="drag-handle">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="4" cy="4" r="1.5" fill="currentColor" /><circle cx="4" cy="9" r="1.5" fill="currentColor" /><circle cx="4" cy="14" r="1.5" fill="currentColor" /><circle cx="9" cy="4" r="1.5" fill="currentColor" /><circle cx="9" cy="9" r="1.5" fill="currentColor" /><circle cx="9" cy="14" r="1.5" fill="currentColor" /></svg>
        </div>
        <div class="tarea-content">
            <div class="tarea-header">
                <div class="tarea-nombre">@item.tarea.Nombre</div>
                <div class="tarea-tipo">@item.tarea.TipoLabel</div>
            </div>
            <div class="tarea-details">
                @if (!string.IsNullOrEmpty(item.tarea.Fecha))
                {
                    <span class="tarea-fecha">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><rect x="0.5" y="1.5" width="9" height="8" rx="1" stroke="currentColor" stroke-width="0.8" /><path d="M3 0.5v2M7 0.5v2M0.5 4h9" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                        @DateTime.Parse(item.tarea.Fecha).ToString("dd/MM/yyyy")
                    </span>
                }
                @if (!string.IsNullOrEmpty(item.tarea.Hora))
                {
                    <span class="tarea-hora">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="0.8" /><path d="M5 3v2l1.5 1.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                        @item.tarea.Hora
                    </span>
                }
                @if (item.showDay && !string.IsNullOrEmpty(item.tarea.DiaSemana))
                {
                    <span class="tarea-diasemana">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="0.8" /><path d="M5 2.5v3L7 6.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                        @item.tarea.DiaSemana
                    </span>
                }
                @if (!string.IsNullOrEmpty(item.tarea.Persona))
                {
                    <span class="tarea-persona">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="3" cy="2.5" r="1.5" stroke="currentColor" stroke-width="0.8" /><path d="M0.5 9.5c0-1.3 1.3-2.5 2.5-2.5s2.5 1.2 2.5 2.5" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" /></svg>
                        @item.tarea.Persona
                    </span>
                }
            </div>
        </div>
        <div class="tarea-actions">
            <a asp-page="/AgregarTarea" asp-route-id="@item.tarea.Id" class="btn-action btn-edit">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 10l1.5-1.5 6.5-6.5 1.5 1.5-6.5 6.5L2 10z" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /><path d="M8.5 2.5l2.5 2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" /></svg>
                Modificar
            </a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@item.tarea.Id" style="display: inline;">
                <button type="submit" class="btn-action btn-delete" onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 3h12M4 3v8c0 0.6 0.4 1 1 1h4c0.6 0 1-0.4 1-1V3M6 5v5M8 5v5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Eliminar
                </button>
            </form>
        </div>
    </div>;
}

<script>
    // ─── Drag & Drop ──────────────────────────────────────────────────────────
    let draggedItem = null;
    let draggedFromList = null;

    document.addEventListener('dragstart', (e) => {
        if (e.target.classList.contains('tarea-item')) {
            draggedItem = e.target;
            draggedFromList = e.target.closest('.tareas-list');
            e.target.style.opacity = '0.5';
        }
    });

    document.addEventListener('dragend', (e) => {
        if (e.target.classList.contains('tarea-item')) {
            e.target.style.opacity = '1';
            draggedItem = null;
            draggedFromList = null;
        }
    });

    document.addEventListener('dragover', (e) => {
        e.preventDefault();
        const list = e.target.closest('.tareas-list');
        if (list && draggedItem && draggedFromList && list === draggedFromList) {
            const afterElement = getDragAfterElement(list, e.clientY);
            if (afterElement == null) {
                list.appendChild(draggedItem);
            } else {
                list.insertBefore(draggedItem, afterElement);
            }
        }
    });

    function getDragAfterElement(container, y) {
        const draggableElements = [...container.querySelectorAll('.tarea-item:not([style*="opacity"])')];
        return draggableElements.reduce((closest, child) => {
            const box = child.getBoundingClientRect();
            const offset = y - box.top - box.height / 2;
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    // ─── Guardar orden al soltar ──────────────────────────────────────────────
    document.addEventListener('drop', async (e) => {
        e.preventDefault();
        if (draggedFromList) {
            const ids = [...draggedFromList.querySelectorAll('.tarea-item')].map(item => parseInt(item.dataset.id));
            await saveOrder(ids);
        }
    });

    async function saveOrder(ids) {
        try {
            const response = await fetch('/api/tareas/reorder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(ids)
            });

            if (!response.ok) {
                console.error('Error al guardar orden');
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }
</script>

<style>
    .section-group {
        margin-bottom: 2rem;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text-primary);
        margin-bottom: 0.75rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border-secondary);
    }

    .tareas-list {
        display: flex;
        flex-direction: column;
        gap: 0;
        min-height: 40px;
    }

    .tarea-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 0.5px solid var(--color-border-tertiary);
        gap: 1rem;
        transition: background 0.15s;
        cursor: grab;
    }

    .tarea-item:active {
        cursor: grabbing;
    }

    .tarea-item:last-child {
        border-bottom: none;
    }

    .tarea-item:hover {
        background: rgba(26, 58, 92, 0.03);
    }

    .drag-handle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        color: var(--color-text-tertiary);
        cursor: grab;
        flex-shrink: 0;
    }

    .drag-handle:active {
        cursor: grabbing;
    }

    .tarea-content {
        flex: 1;
        min-width: 0;
    }

    .tarea-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 6px;
    }

    .tarea-nombre {
        font-size: 14px;
        font-weight: 500;
        color: var(--color-text-primary);
    }

    .tarea-tipo {
        font-size: 11px;
        background: var(--color-background-secondary);
        color: var(--color-text-secondary);
        padding: 2px 8px;
        border-radius: 99px;
        white-space: nowrap;
    }

    .tarea-details {
        display: flex;
        gap: 12px;
        font-size: 11px;
        color: var(--color-text-terciary);
        flex-wrap: wrap;
    }

    .tarea-fecha,
    .tarea-hora,
    .tarea-diasemana,
    .tarea-persona {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .tarea-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        font-size: 12px;
        border-radius: var(--border-radius-md);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s;
        border: 0.5px solid;
        background: transparent;
        font-family: var(--font-sans);
    }

    .btn-edit {
        color: #1a3a5c;
        border-color: #1a3a5c;
    }

    .btn-edit:hover {
        background: rgba(26, 58, 92, 0.1);
    }

    .btn-delete {
        color: #dc3545;
        border-color: #dc3545;
    }

    .btn-delete:hover {
        background: rgba(220, 53, 69, 0.1);
    }
</style>
