<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CheckList</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checklist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CheckList.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    <header>
        <div class="navbar">
            <a asp-page="/Index" class="nav-brand">
                <img src="~/images/logo.png"
                     alt="Bubu y Dudu"
                     class="brand-logo" />
                Bubu y Dudu Tareas
            </a>
            <a asp-page="/AgregarTarea" class="nav-btn">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M6.5 2v9M2 6.5h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                Agregar
            </a>
            <a asp-page="/ListarTarea" class="nav-btn">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2 10l1.5-1.5 6.5-6.5 1.5 1.5-6.5 6.5L2 10z" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" /><path d="M8.5 2.5l2 2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /></svg>
                Modificar
            </a>
            <a asp-page="/CalendarioTarea" class="nav-btn">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><rect x="0.5" y="1.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.1" /><path d="M4 0.5v2M9 0.5v2M0.5 5.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" /><circle cx="3.5" cy="8" r="0.8" fill="currentColor" /><circle cx="6.5" cy="8" r="0.8" fill="currentColor" /><circle cx="9.5" cy="8" r="0.8" fill="currentColor" /></svg>
                Calendario
            </a>
            <a asp-page="/Compras" class="nav-btn">
                🛒 Compras
            </a>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Bubu y Dudu tareas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .brand-logo {
    height: 40px;
    width: auto;
    display: block;
    }

    .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    }
</style>
